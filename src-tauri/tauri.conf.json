{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ktcedit",
  "version": "0.2.0",
  "identifier": "com.lolo.ktcedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ktcedit",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOEY4QTFGMzc0M0Q3NEUKUldSTzEwTTNINHFQMjk1bmZ4MUJPb3dSYjkzemxyUHNrdW4xOXl2SlJOVG1mSmFacGVCejRiSnoK",
      "endpoints": [
        "https://github.com/lxwiq/ktc-edit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
